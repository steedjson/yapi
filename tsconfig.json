{
  "compilerOptions": {
    "target": "ES2018",
    "module": "commonjs",
    "allowJs": true,
    "checkJs": false,
    "jsx": "preserve",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    // webpack 别名 common -> 仓库根 common/；TS 7.0.2 在无 baseUrl 时 paths 值须以 ./ 开头
    "paths": {
      "common/*": ["./common/*"],
      // webpack 别名 exts -> 仓库根 exts/；P8b 后 exts 全量插件文件已受检，
      // client/plugin-module.js 的 require('exts/...') 直接解析到真实受检文件，
      // 不再依赖 global.d.ts 的 'exts/*' 通配存根。
      "exts/*": ["./exts/*"]
    },
    // 实测（TypeScript 7.0.2）：缺省 types 不会自动枚举 node_modules/@types，
    // 移除该字段后 server/utils/sandbox_child.js 立即出现 TS2591
    // （Cannot find name 'process' / 'require'）。故须显式声明 node 以使用 Node API 类型。
    "types": ["node"]
  },
  "include": [
