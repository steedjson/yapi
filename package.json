{
  "name": "yapi-vendor",
  "version": "1.11.0",
  "description": "YAPI",
  "main": "server/app.js",
  "scripts": {
    "dev-copy-icon": "cp -r static/iconfont ./",
    "dev-server": " nodemon server/app.js dev -L",
    "install-server": " node server/install.js",
    "dev-client": "npm run dev-client-standalone",
    "dev": "npm run dev-server & npm run dev-client",
    "start": " node server/app.js",
    "test": "ava",
    "audit": "npm audit --registry=https://registry.npmjs.org",
    "audit:ci": "node scripts/audit-check.js",
    "lint": "eslint client/ server/ common/ exts/ test/",
    "typecheck": "tsc --noEmit",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "build-client": "npm run build-client-standalone",
    "npm-publish": "node ./npm-publish.js",
    "docs": "ydoc build",
    "build-client-standalone": "NODE_ENV=production node build/webpack-standalone.js",
    "dev-client-standalone": "npm run dev-copy-icon && NODE_ENV=development node build/webpack-dev-standalone.js",
    "postinstall": "patch-package && simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run lint",
    "commit-msg": "npx --no -- commitlint -e \"$1\""
  },
  "scripts-info": {
    "start": "运行生产环境服务器",
    "install-server": "初始化数据库数据，用于安装",
    "dev": "运行开发服务器",
    "dev-server": "运行后端开发服务器",
    "dev-client": "运行前端开发服务器",
    "test": "执行测试"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:YMFE/yapi.git"
  },
  "author": "",
  "license": "Apache-2.0",
