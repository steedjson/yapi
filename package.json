{
  "name": "yapi-vendor",
  "version": "1.11.0",
  "description": "YAPI",
  "main": "server/app.js",
  "scripts": {
    "dev-copy-icon": "cp -r static/iconfont ./",
    "dev-server": " nodemon server/app.js dev -L",
    "install-server": " node server/install.js",
    "dev-client": "npm run dev-client-standalone",
    "dev": "npm run dev-server & npm run dev-client",
    "start": " node server/app.js",
    "test": "ava",
    "typecheck": "tsc --noEmit",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "build-client": "npm run build-client-standalone",
    "npm-publish": "node ./npm-publish.js",
    "docs": "ydoc build",
    "build-client-standalone": "NODE_ENV=production node build/webpack-standalone.js",
    "dev-client-standalone": "npm run dev-copy-icon && NODE_ENV=development node build/webpack-dev-standalone.js",
    "postinstall": "patch-package"
  },
  "scripts-info": {
    "start": "运行生产环境服务器",
    "install-server": "初始化数据库数据，用于安装",
    "dev": "运行开发服务器",
    "dev-server": "运行后端开发服务器",
    "dev-client": "运行前端开发服务器",
    "test": "执行测试"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:YMFE/yapi.git"
  },
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "ajv": "^5.5.1",
    "ajv-i18n": "^2.2.0",
    "axios": "1.20.0",
    "compare-versions": "^3.4.0",
    "copy-to-clipboard": "3.0.8",
    "cpu-load": "^1.0.0",
    "crypto-js": "^3.1.9-1",
    "easy-json-schema": "0.0.2-beta",
    "extend": "3.0.2",
    "fs-extra": "^3.0.1",
    "immer": "^1.1.1",
    "js-base64": "^2.3.2",
    "json-schema-faker": "0.5.0-rc16",
    "json5": "0.5.1",
    "jsondiffpatch": "0.3.11",
    "jsonwebtoken": "9.0.2",
    "jsrsasign": "^8.0.12",
    "koa": "2.16.4",
    "koa-body": "^2.5.0",
    "koa-router": "^7.0.1",
    "koa-static": "5.0.0",
    "koa-websocket": "4.0.0",
    "ldapjs": "3.0.7",
    "markdown-it": "8.4.0",
    "markdown-it-anchor": "4.0.0",
    "markdown-it-table-of-contents": "0.3.2",
    "md5": "2.2.1",
    "mime": "1.6.0",
    "mockjs": "1.0.1-beta3",
    "moment": "^2.19.3",
    "mongoose": "8.24.4",
    "node-schedule": "2.1.1",
    "nodemailer": "10.0.10",
    "qs": "^6.7.0",
    "sha.js": "2.4.9",
    "sha1": "1.1.1",
    "swagger-client": "^3.5.1",
    "underscore": "1.8.3",
    "url": "0.11.0",
    "yapi-plugin-qsso": "^1.1.0"
  },
  "devDependencies": {
    "@ant-design/icons": "4.8.1",
    "@babel/core": "7.28.4",
    "@babel/plugin-proposal-decorators": "7.28.0",
    "@babel/plugin-transform-runtime": "7.28.3",
    "@babel/preset-env": "7.28.3",
    "@babel/preset-react": "7.27.1",
    "@babel/register": "7.28.3",
    "@babel/runtime": "7.28.4",
    "antd": "^4.24.16",
    "assets-webpack-plugin": "^3.5.1",
    "ava": "6.4.1",
    "babel-eslint": "^7.2.3",
    "babel-loader": "8.4.1",
    "babel-plugin-import": "^1.3.1",
    "brace": "^0.10.0",
    "compression-webpack-plugin": "1.1.12",
    "conventional-changelog-cli": "^2.1.1",
    "core-decorators": "^0.17.0",
    "css-loader": "^0.28.4",
    "eslint": "^3.19.0",
    "eslint-plugin-import": "^2.2.0",
    "eslint-plugin-react": "^7.1.0",
    "file-loader": "1.1.11",
    "ghooks": "^2.0.0",
    "json-schema-editor-visual": "^1.0.23",
    "less": "^3.13.1",
    "less-loader": "^4.0.5",
    "markdown-it-include": "^1.0.0",
    "mini-css-extract-plugin": "0.9.0",
    "nodemon": "^1.11.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.6",
    "prop-types": "^15.5.10",
    "rc-queue-anim": "^1.2.0",
    "rc-scroll-anim": "^1.0.7",
    "rc-tween-one": "^1.5.5",
    "react": "16.14.0",
    "react-dnd": "^2.5.1",
    "react-dnd-html5-backend": "^2.5.1",
    "react-dom": "16.14.0",
    "react-redux": "7.2.9",
    "react-router": "5.3.4",
    "react-router-dom": "5.3.4",
    "reactabular-dnd": "^8.9.0",
    "reactabular-table": "^8.9.0",
    "recharts": "^1.0.0-beta.0",
    "redux": "^3.7.1",
    "redux-promise": "^0.5.3",
    "rewire": "^2.5.2",
    "sass": "^1.22.10",
    "sass-loader": "^7.2.0",
    "style-loader": "^0.18.2",
    "table-resolver": "^3.2.0",
    "typescript": "7.0.2",
    "url-loader": "1.1.2",
    "validate-commit-msg": "^2.12.2",
    "webpack": "4.47.0",
    "webpack-cli": "3.3.12",
    "webpack-dev-middleware": "^3.7.3",
    "webpack-hot-middleware": "^2.26.1",
    "webpack-node-externals": "^1.6.0",
    "ydoc-plugin-img-view": "^1.0.1"
  },
  "config": {
    "ghooks": {
      "commit-msg": "validate-commit-msg"
    },
    "validate-commit-msg": {
      "types": [
        "feat",
        "fix",
        "docs",
        "test",
        "chore",
        "refactor",
        "opti"
      ],
      "warnOnFail": false,
      "maxSubjectLength": 100,
      "subjectPattern": ".+",
      "subjectPatternErrorMsg": "请输入message信息!",
      "helpMessage": "Commit message 格式错误， http://www.ruanyifeng.com/blog/2016/01/commit_message_change_log.html"
    }
  },
  "engines": {
    "node": ">=18 <25",
    "npm": ">=8"
  }
}
